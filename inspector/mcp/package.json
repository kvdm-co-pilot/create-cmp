{
  "name": "@create-cmp/inspector",
  "version": "0.8.0",
  "mcpName": "io.github.kvdm-co-pilot/cmp-inspector",
  "description": "MCP server that reads a running Compose Multiplatform UI as structured JSON (hierarchy + geometry + resolved design tokens) and exposes query/assert/token-drift tools — never screenshots. Phase 0 of the create-cmp inspector.",
  "type": "module",
  "bin": {
    "cmp-inspector-mcp": "bin/server.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node bin/server.mjs",
    "build:bundle": "node scripts/build-bundle.mjs",
    "check:bundle": "node scripts/build-bundle.mjs --check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "compose-multiplatform",
    "kmp",
    "cmp",
    "inspector",
    "design-tokens"
  ],
  "license": "MIT",
  "author": "Karel van der Merwe",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25 || ^4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "homepage": "https://github.com/kvdm-co-pilot/create-cmp/tree/main/inspector/mcp#readme",
  "bugs": {
    "url": "https://github.com/kvdm-co-pilot/create-cmp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvdm-co-pilot/create-cmp.git",
    "directory": "inspector/mcp"
  },
  "publishConfig": {
    "access": "public"
  }
}
