{
  "permissions": {
    "ask": [
      "Edit(scripts/hooks/**)",
      "Write(scripts/hooks/**)",
      "Edit(scripts/proof-plan.mjs)",
      "Edit(scripts/observed-tree.mjs)",
      "Edit(scripts/stamped-output.mjs)",
      "Edit(qa-artifacts/**)",
      "Write(qa-artifacts/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/proof-gate.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/fail-closed.sh\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/proof-gate.mjs\" \"gh|npm|npx|pnpm|bun|yarn|git push|fleet-check\" 10",
            "timeout": 11
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/proof-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
