{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/proof-gate.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/fail-closed.sh\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/proof-gate.mjs\" \"gh|npm|npx|pnpm|bun|yarn|git push|fleet-check\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/proof-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
